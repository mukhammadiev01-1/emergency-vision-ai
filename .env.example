# ==========================================
# Emergency Vision AI Environment Config
# ==========================================

# ------------------------------------------
# API Settings
# ------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_TITLE="Emergency Vision AI API"
API_VERSION="0.1.0"
API_CORS_ORIGINS=["*"]

# ------------------------------------------
# Worker / Pipeline Settings
# ------------------------------------------
WORKER_DEVICE=cpu
DETECTION_MODEL_PATH=models/detection/yolo11n.pt
ACTION_MODEL_PATH=models/action_recognition/r3d18_urfd_person_crops.pth
TRACKER_TYPE=bytetrack.yaml

# Inference Parameters
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
DETECTION_CLASSES=[0]

# Action Recognition Parameters (R3D-18 Fall Detection)
ENABLE_ACTION_RECOGNITION=true
ACTION_CONFIDENCE_THRESHOLD=0.70
ACTION_CONSECUTIVE_WINDOWS=2
ACTION_COOLDOWN_SECONDS=5.0
ACTION_INFERENCE_INTERVAL=8
ACTION_CROP_PADDING_RATIO=0.05
ACTION_STALE_TRACK_TIMEOUT=3.0

# Video & Capture
VIDEO_SOURCE=0
CAPTURE_FPS=30.0
FRAME_SKIP=1
ENABLE_VISUALIZATION=false

# Line Crossing Event Detection
LINE_CROSSING_ORIENTATION=horizontal
LINE_CROSSING_POSITION_RATIO=0.5

# ------------------------------------------
# Redis Streams Event Transport
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=emergency_vision:events
EVENT_PUBLISHER_TYPE=redis

# ------------------------------------------
# Future Database Integration Placeholders
# ------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/emergency_vision
